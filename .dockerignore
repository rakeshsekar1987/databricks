# =============================================================================
# Docker Ignore File - Angular Module Federation POC
# =============================================================================

# Dependencies
node_modules
**/node_modules

# Build outputs
dist
**/dist

# IDE and editors
.idea
.vscode
*.swp
*.swo
*~

# Git
.git
.gitignore

# Docker files (prevent recursive copying)
Dockerfile*
docker-compose*.yml
.docker

# Documentation
*.md
!README.md
docs

# Test files
coverage
**/*.spec.ts
**/*.test.ts
e2e
karma.conf.js

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Environment files (keep only example)
.env
.env.local
.env.*.local

# Misc
.angular
.editorconfig
.browserslistrc
*.tgz
*.tar.gz
