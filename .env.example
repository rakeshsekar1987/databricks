# Environment Configuration
# Copy this file to .env.local for local development

# Node Environment
NODE_ENV=development

# Application URLs (Development)
SHELL_URL=http://localhost:3000
REG_REPORTING_URL=http://localhost:3001
FINANCIAL_REPORTING_URL=http://localhost:3002
EXPENSE_REPORTING_URL=http://localhost:3003
TAX_REPORTING_URL=http://localhost:3004
CONTROL_TOWER_URL=http://localhost:3005

# Module Registry
MODULE_REGISTRY_URL=http://localhost:4000

# API Configuration
API_BASE_URL=http://localhost:8080/api

# Feature Flags
ENABLE_DYNAMIC_REMOTES=true
ENABLE_MODULE_PRELOADING=true

# Monitoring
ENABLE_PERFORMANCE_MONITORING=true
SENTRY_DSN=

# CDN Configuration (Production)
CDN_BASE_URL=https://cdn.example.com/ui-modules

# JFrog Configuration
JFROG_URL=https://artifactory.example.com
JFROG_REPO=ui-modules
