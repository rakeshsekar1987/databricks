# Microsoft Bot Framework Configuration
MICROSOFT_APP_ID=your-bot-app-id
MICROSOFT_APP_PASSWORD=your-bot-app-password
MICROSOFT_APP_TENANT_ID=your-tenant-id

# Azure AD SSO Configuration
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id

# Timesheet Application Configuration
TIMESHEET_API_BASE_URL=https://your-timesheet-app.com/api
TIMESHEET_API_KEY=your-timesheet-api-key

# Bot Configuration
BOT_DOMAIN=https://your-bot-domain.azurewebsites.net
PORT=3978

# Reminder Configuration (Cron format)
# Default: Every Friday at 3:00 PM
REMINDER_CRON_SCHEDULE=0 15 * * 5

# Manager Notification Settings
INCLUDE_MANAGER_IN_REMINDER=true

# Graph API Scopes for SSO
GRAPH_API_SCOPES=User.Read,User.ReadBasic.All,Mail.Send
