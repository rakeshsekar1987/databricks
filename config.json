{
    "version": "2.0.0",
    "description": "Configuration for Excel to JSON Transformation Framework - Data-Driven Version",
    "approach": "All mappings are derived from input data, no hardcoding required",
    
    "inputTabs": {
        "required": [
            {
                "name": "Cards",
                "primaryKey": "Card Name",
                "purpose": "Report/card definitions"
            },
            {
                "name": "Funds",
                "primaryKey": "Fund ID_New",
                "purpose": "Fund master data for cross-reference lookups"
            },
            {
                "name": "Validations - TRIMMED",
                "foreignKeys": ["Card", "Fund"],
                "purpose": "Normal validation records"
            },
            {
                "name": "Validations - KRI",
                "foreignKeys": ["Card", "Fund"],
                "purpose": "KRI validation records with variable columns"
            }
        ],
        "optional": [
            {
                "name": "KRI Master",
                "columns": ["KRI ID", "KRI Name", "KRI Desc", "Threshold", "Validation ID"],
                "purpose": "Pre-defined KRI IDs and thresholds (if not provided, generated sequentially)"
            }
        ]
    },
    
    "derivedMappings": {
        "description": "All these mappings are derived from input data automatically",
        
        "groupLetter": {
            "source": "Funds.Fund ID_New",
            "rule": "Extract numeric suffix, convert to letter (1→A, 2→B, 3→C, ...)",
            "examples": {
                "CAN1": "A",
                "CAN2": "B",
                "CAN3": "C",
                "FUND10": "J",
                "ABC123": "The 123rd letter would wrap around"
            }
        },
        
        "kriId": {
            "withKRIMaster": "Lookup from KRI Master.KRI ID",
            "withoutKRIMaster": "Generate sequentially: KRI_1, KRI_2, KRI_3, ...",
            "note": "Order is based on first occurrence in Validations-KRI tab"
        },
        
        "validationId": {
            "normalValidations": "Sequential starting from 1001",
            "kriValidations": {
                "withKRIMaster": "Lookup from KRI Master.Validation ID",
                "withoutKRIMaster": "Base (999990) + order index"
            }
        }
    },
    
    "crossReferences": {
        "Validations.Fund → Funds.Fund ID_New": {
            "lookupFields": ["Trust_New", "Book_New", "Fund Name_New"],
            "derivedFields": ["group (from Fund ID pattern)"]
        },
        "Validations.Card → Cards.Card Name": {
            "purpose": "Context and filtering only"
        }
    },
    
    "calculations": {
        "rowCount": "COUNT(Validations-TRIMMED) + COUNT(Validations-KRI)",
        "kriTotalCount": "COUNT(DISTINCT Validations-KRI.Validation)",
        "kriStatusCount_perFund": "COUNT(Validations-KRI WHERE Fund = fundCode)",
        "kriStatusCount_total": "COUNT(Validations-KRI)",
        "risk": {
            "formula": "Based on abs(BPS Impact)",
            "thresholds": {
                "High": "≥ 30%",
                "Medium": "≥ 15% and < 30%",
                "Low": "< 15%"
            }
        }
    },
    
    "fieldMappings": {
        "description": "Maps Excel column names to JSON field names",
        
        "fromFundsTab": {
            "Trust_New": "trust",
            "Book_New": ["book", "fundName (JSON2)"],
            "Fund Name_New": "fundName (JSON3)",
            "Fund ID_New": ["fund", "fundCode", "derived: group"]
        },
        
        "fromValidationsTab": {
            "Fund": "fund, fundCode",
            "Priority": "priority",
            "Workflow Status": "webappWorkflowStatus",
            "Validation Status": "validationStatus",
            "Validation": "validation",
            "Statement Type": "statementType",
            "Section": "section",
            "Line Item Description": "lineItemDescription",
            "Control Procedures": "validationDesc (for KRI)",
            "Share Class": "shareClass",
            "Control Value": "controlValue (parsed as number)",
            "FS Value": "fsValue (parsed, commas removed)",
            "Variance": "variance (parsed as number)",
            "BPS Impact": "bpsImpact (parsed as number)",
            "Auto / Manual": "autoManual",
            "Validation Source": "validationSource",
            "Validation Type": "validationType",
            "Control Draft Number": "controlDraftNumber (extract integer)",
            "Test Draft Number": "testDraftNumber",
            "Is Final": "isFinalDraft (boolean)",
            "Threshold Amount": "thresholdColAmount",
            "Threshold Desc": "thresholdColDesc",
            "Threshold Percent (%)": "thresholdPercent",
            "Threshold Abs": "thresholdAbs",
            "KRI Variable Key1-5 + Value1-5": "valuesUsedInFormula (JSON object)"
        }
    },
    
    "autoGeneratedFields": {
        "id": "Hash of card + fund + validation + index",
        "validationId": "Sequential (normal) or from KRI mapping (KRI)",
        "requestId": "UUID without hyphens, uppercase",
        "auditVersionControlDs": "Always '1'",
        "writeTs": "Current timestamp (YYYY-MM-DD HH:mm:ss.SSSSSSS)"
    },
    
    "defaultValues": {
        "description": "Default values when not derivable from data",
        "analyticsStatus": "High",
        "strategy": "Credit - Diversified Income (could be added as Funds column)",
        "statusFilter": ["Low", "N/A", "High"],
        "threshold": "{\"High\": \">30%\",\"Medium\": \">=15% and <30%\",\"Low\":\"<15%\"}",
        "flagFields": {
            "isCpoControl": "0",
            "isCpoTest": "0",
            "isBannerLessControl": "0",
            "isBannerLessTest": "0",
            "isBlueFontControl": "0",
            "isBlueFontTest": "0"
        }
    },
    
    "outputFiles": {
        "json1": {
            "filename": "validations_combined.json",
            "description": "Combined validations from TRIMMED and KRI tabs",
            "rowCount": "Calculated from data"
        },
        "json2": {
            "filename": "kri_details.json",
            "description": "KRI details grouped by KRI type with fund details"
        },
        "json3": {
            "filename": "fund_kri_status.json",
            "description": "Fund KRI status counts and filters - counts from data"
        },
        "json4": {
            "filename": "strategy_kri_count.json",
            "description": "Strategy-level KRI aggregation - counts from data"
        },
        "json5": {
            "filename": "kri_simple.json",
            "description": "Simple KRI details list for filtering"
        }
    },
    
    "extensibility": {
        "addNewFund": "Add row to Funds tab - automatically picked up",
        "addNewKRI": "Add row to Validations-KRI tab - auto-generates ID or use KRI Master",
        "addStrategy": "Add 'Strategy' column to Funds tab to make it data-driven",
        "customGroupMapping": "Modify Fund ID_New pattern or add 'Output Group' column",
        "customKRIIds": "Use KRI Master tab for specific KRI IDs"
    }
}
