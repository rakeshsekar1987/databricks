# Remote Module - Production Dockerfile
# Generic dockerfile for all remote modules
# Build arg: MODULE_NAME (e.g., tax-reporting, reg-reporting)

# ============================================
# Stage 1: Dependencies
# ============================================
FROM node:18-alpine AS deps

ARG MODULE_NAME

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

# Copy workspace configuration
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY turbo.json ./
COPY tsconfig.base.json ./

# Copy package.json files
COPY packages/shared-library/package.json ./packages/shared-library/
COPY apps/${MODULE_NAME}/package.json ./apps/${MODULE_NAME}/

# Install dependencies
RUN pnpm install --frozen-lockfile --prefer-offline

# ============================================
# Stage 2: Builder
# ============================================
FROM node:18-alpine AS builder

ARG MODULE_NAME
ARG NODE_ENV=production

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

# Copy dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/shared-library/node_modules ./packages/shared-library/node_modules
COPY --from=deps /app/apps/${MODULE_NAME}/node_modules ./apps/${MODULE_NAME}/node_modules

# Copy source
COPY packages/shared-library ./packages/shared-library
COPY apps/${MODULE_NAME} ./apps/${MODULE_NAME}
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./

# Build
ENV NODE_ENV=${NODE_ENV}
RUN pnpm --filter @platform/shared-library build
RUN pnpm --filter @platform/${MODULE_NAME} build

# ============================================
# Stage 3: Production
# ============================================
FROM nginx:alpine AS production

ARG MODULE_NAME

# Install curl for health checks
RUN apk add --no-cache curl

# Create non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Copy nginx configuration
COPY infrastructure/docker/nginx/module.conf /etc/nginx/conf.d/default.conf

# Copy built assets
COPY --from=builder /app/apps/${MODULE_NAME}/dist /usr/share/nginx/html

# Set ownership
RUN chown -R appuser:appgroup /usr/share/nginx/html && \
    chown -R appuser:appgroup /var/cache/nginx && \
    chown -R appuser:appgroup /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R appuser:appgroup /var/run/nginx.pid

# Health check - verify remoteEntry.js is accessible
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/remoteEntry.js || exit 1

EXPOSE 80

USER appuser

CMD ["nginx", "-g", "daemon off;"]
