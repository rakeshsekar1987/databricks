{
  "name": "ui-module-federation-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Angular Module Federation Platform - Independent micro-frontends with Motif library and separate AG Grid versions",
  "scripts": {
    "start": "npm run start:all",
    "start:all": "concurrently \"npm run start:shell\" \"npm run start:reg-reporting\" \"npm run start:financial-reporting\" \"npm run start:expense-reporting\" \"npm run start:tax-reporting\" \"npm run start:control-tower\"",
    "start:shell": "ng serve shell --port 4200",
    "start:reg-reporting": "ng serve reg-reporting --port 4201",
    "start:financial-reporting": "ng serve financial-reporting --port 4202",
    "start:expense-reporting": "ng serve expense-reporting --port 4203",
    "start:tax-reporting": "ng serve tax-reporting --port 4204",
    "start:control-tower": "ng serve control-tower --port 4205",
    "build": "npm run build:shared && npm run build:all",
    "build:shared": "ng build shared-lib --configuration production",
    "build:all": "npm run build:shell && npm run build:reg-reporting && npm run build:financial-reporting && npm run build:expense-reporting && npm run build:tax-reporting && npm run build:control-tower",
    "build:shell": "ng build shell --configuration production",
    "build:reg-reporting": "ng build reg-reporting --configuration production",
    "build:financial-reporting": "ng build financial-reporting --configuration production",
    "build:expense-reporting": "ng build expense-reporting --configuration production",
    "build:tax-reporting": "ng build tax-reporting --configuration production",
    "build:control-tower": "ng build control-tower --configuration production",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@angular-architects/module-federation": "^17.0.0",
    "@mfs/motif": "^10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular-eslint/builder": "^17.0.0",
    "@angular-eslint/eslint-plugin": "^17.0.0",
    "@angular-eslint/eslint-plugin-template": "^17.0.0",
    "@angular-eslint/schematics": "^17.0.0",
    "@angular-eslint/template-parser": "^17.0.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^17.3.0",
    "ngx-build-plus": "^17.0.0",
    "typescript": "~5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
