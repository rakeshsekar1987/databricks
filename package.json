{
  "name": "ui-module-federation",
  "version": "1.0.0",
  "private": true,
  "description": "UI/UX Module Federation Platform - Independent micro-frontends with separate AG Grid versions",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:shell": "turbo run build --filter=@platform/shell",
    "build:reg-reporting": "turbo run build --filter=@platform/reg-reporting",
    "build:financial-reporting": "turbo run build --filter=@platform/financial-reporting",
    "build:expense-reporting": "turbo run build --filter=@platform/expense-reporting",
    "build:tax-reporting": "turbo run build --filter=@platform/tax-reporting",
    "build:control-tower": "turbo run build --filter=@platform/control-tower",
    "build:shared": "turbo run build --filter=@platform/shared-library",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
